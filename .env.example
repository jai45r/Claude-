# Copy this file to .env and fill it in. Never commit .env.

# --- Claude API ---
ANTHROPIC_API_KEY=
# Model and effort for research. Effort: low | medium | high | xhigh
LEADAGENT_MODEL=claude-opus-5-5
LEADAGENT_EFFORT=high

# --- Email sending ---
# dry_run = nothing is sent; approved emails are written to data/outbox/ so you can check them.
# graph   = send through Microsoft 365 (Microsoft Graph). See README "Connect Microsoft 365".
MAIL_MODE=dry_run
SENDER_EMAIL=admin@pdesigns.com.au
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Safety limits
MAX_SENDS_PER_DAY=15
FOLLOWUP_AFTER_DAYS=7
MAX_FOLLOWUPS=2

# Dashboard
DASHBOARD_PORT=5050
